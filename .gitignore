# Secrets and data that must never be committed
# (legacy static-site dotfiles; the plugin reads secrets from wp-config.php constants)
**/.printful-token
**/.stripe-secret
**/.stripe-webhook-secret
**/.stripe-*
**/.price-multiplier
**/.inscription-promo
**/.inscription-current
**/.inscription-notify
**/.inscription-notify-from
**/.inscription-*
**/.smtp
**/inscriptions.jsonl

# Raw photo dumps that are not referenced by any page (keep them out of the repo)
_photo-index.jpg
public/assets/images/IMG_*
public/assets/images/PHOTO-*
public/assets/images/capoeira_2_*

# The theme vendors Leaflet (not a Composer vendor dir).
!themes/puracapoeira/assets/vendor/
