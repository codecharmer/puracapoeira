{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "pura/sedes-grid",
	"version": "1.0.0",
	"title": "Sedes",
	"category": "pura",
	"icon": "location-alt",
